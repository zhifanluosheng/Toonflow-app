{
  "name": "dsh-toonflow",
  "version": "0.1.0",
  "description": "Toonflow 工作台 —— 把 Toonflow-app（Bun + Vue3 + Express）以整页 iframe 嵌入 DSH Desktop；前端经 127.0.0.1:3000 访问 Toonflow 自带 HTTP 服务。",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "workbench",
    "toonflow",
    "ai",
    "storyboard"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.6-alpha.2 <0.2.0-0"
  }
}
